# ═══ Metadata Database (MySQL) ═══
METADATA_DB_TYPE=mysql
METADATA_DB_HOST=localhost
METADATA_DB_PORT=3306
METADATA_DB_USER=root
METADATA_DB_PASSWORD=
METADATA_DB_DATABASE=adh

# ═══ Vector Database (Doris) — for HNSW vector search ═══
VECTOR_DB_TYPE=doris
VECTOR_DB_HOST=localhost
VECTOR_DB_PORT=9030
VECTOR_DB_USER=root
VECTOR_DB_PASSWORD=
VECTOR_DB_DATABASE=adh

# ═══ Application ═══
ADH_SECRET_KEY=
ADH_DEFAULT_ADMIN_PASSWORD=

# ═══ LLM (Anthropic) ═══
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ═══ Embedding ═══
EMBEDDING_MODEL_PATH=shibing624/text2vec-base-chinese
EMBEDDING_DIM=768
HF_ENDPOINT=https://hf-mirror.com
