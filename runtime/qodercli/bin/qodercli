#!/bin/sh
# 项目内置 qodercn 执行层 CLI 启动脚本(文件名保持 qodercli: DB cli_path/测试契约的稳定接口)
# 内部指向 @qodercn-ai/qoderclicn(qoder.cn 体系); 使用 runtime/node 与项目内 node_modules,
# 不依赖部署机器的全局安装。详见 runtime/qodercli/setup.sh 与 services/datamind/execution/。
RUNTIME_DIR="$(cd "$(dirname "$0")/.." && pwd)"
NODE_BIN="$RUNTIME_DIR/../node/bin/node"

# 如果内置 node 不存在，回退到系统 node
if [ ! -x "$NODE_BIN" ]; then
    NODE_BIN="node"
fi

exec "$NODE_BIN" "$RUNTIME_DIR/node_modules/@qodercn-ai/qoderclicn/bundle/qoderclicn.js" "$@"
