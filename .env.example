# ═══════════════════════════════════════════════════════════════════
# AI-DataHub 环境配置
# 复制此文件为 .env 并修改对应的值
# ═══════════════════════════════════════════════════════════════════

# ── MySQL 数据库 ──────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=chatbi_root_2024
MYSQL_USER=chatbi
MYSQL_PASSWORD=chatbi_pass_2024
MYSQL_PORT=3306

# ── 应用端口 ──────────────────────────────────────────────────────
# BACKEND_PORT 只是 compose 的宿主映射；后端进程监听口的唯一登记处是
# backend/scripts/services.conf（web:backend.app.main:8000），改它要同步 vite 代理与
# nginx 上游，见 tests/test_merged_webapp.py 的端口口径护栏。
BACKEND_PORT=8000
# FRONTEND_PORT 是前端启动端口的唯一配置源：start-all.sh / stop-all.sh /
# kill-ports.sh 与 frontend/vite.config.ts 都读这一个键（本地 dev 与容器同源）。
FRONTEND_PORT=3000

# ── LLM 配置 ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── 应用安全 ──────────────────────────────────────────────────────
ADH_SECRET_KEY=change-me-in-production

# ── RDF 三元组存储 (Oxigraph) ───────────────────────────────────────
# 轻量级 SPARQL 1.1 端点，用于 GraphRAG 本体检索
OXIGRAPH_URL=http://localhost:7878
# 图重建写入批量大小：一次 INSERT DATA 装多少个节点。
# 背景：旧实现每列一次 SPARQL UPDATE，而 kind='business' 的保存会触发
# datasource_id=0（“聚合全部数据源”）的全目录重建，1.5 万+ 列就是 1.5 万次
# 串行 HTTP 往返，表现为 save_draft 卡死数百秒不返回。调大可加快，调小可降低
# 单次请求体积；至少为 1。
GRAPH_WRITE_CHUNK=500
# 整场图重建的墙钟预算（秒）。超出即中断并报已写进度，绝不返回部分完成的 success。
# 0 = 明确关闭上界（只给需要跑超大全量重建的场景）；值解析失败会回退默认值而不是关掉防护。
GRAPH_BUILD_DEADLINE_S=600

# ── Redis（分布式缓存 + Celery 队列）───────────────────────
# 统一缓存后端：数据源/菜单/Dashboard/元数据等跨实例共享缓存，进程重启不丢。
# Redis 不可用时缓存透明降级为“无缓存”（回源计算），不影响正确性。
REDIS_URL=redis://localhost:6379/0
# 未设 REDIS_URL 时的回退项：
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ── 元数据存储类型 ────────────────────────────────────────────────
# mysql = MySQL 数据库（默认，生产环境推荐）
# doris = Apache Doris（兼容 MySQL 协议）
METADATA_DB_TYPE=mysql
METADATA_DB_HOST=localhost
METADATA_DB_PORT=3306
METADATA_DB_USER=chatbi
METADATA_DB_PASSWORD=chatbi_pass_2024
METADATA_DB_DATABASE=adh

# ── OpenMetadata 元数据平台集成 ─────────────────────────
# 部署见 docker/om/README.md；完成初始化后将 OM_ENABLED 改为 true
OM_ENABLED=false
OM_SERVER_URL=http://localhost:8585
# ingestion-bot JWT，由 docker/om/init_om.py 自动生成并回写，无需手工配置
OM_AUTH_TOKEN=
OM_ADMIN_EMAIL=admin@open-metadata.org
OM_ADMIN_PASSWORD=admin
# 采集调度 cron（默认每日 02:00）
OM_INGESTION_CRON=0 2 * * *
# 回灌映射: OM 服务名 → 本地 datasource_id
OM_DATASOURCE_MAP=adh_doris:0,adh_mysql:0

# ── LLM 交互可观测（看板『LLM 交互可观测』的数据源）──
# 未开启时全链路 no-op（不落 adh_llm_traces/adh_llm_spans）；开启后 span 文本按上限截断（敏感护栏）
OBSERVABILITY_ENABLED=true
# OBSERVABILITY_SPAN_MAX_CHARS=4096
# credit → 成本折算单价与币种：Qoder CLI 不回报账单成本（实测 total_cost_usd / costUSD 恒为 0），
# 「成本」列由 credit × 单价折算得到（属估算，不是账单值）。
# 默认 0.04 CNY = Qoder CN 企业资源包官方起购价 80 元 / 2,000 Credits
# （源：docs.qoder.cn/product-overview/billing-description；国际版对照 $0.02/Credit）
# RATE 填 0 = 不折算，成本列显示 —（不臆造价格）
OBSERVABILITY_CREDIT_COST_RATE=0.04
OBSERVABILITY_CREDIT_COST_CURRENCY=CNY

# ── 前置意图漏斗（Intent Gate）—— chat 输入进 qodercli 执行层之前的确定性分流 ──
# 寒暄/无效输入/能力询问/使用说明/涉密索要本地直答（不起子进程、不烧 credit），
# 判定不准一律放行 agent。分流只用规则+词典/本体别名命中，不调任何模型。
# off     = 不判定（完全沿用旧行为）
# shadow  = 只判定与度量，行为不变（所有输入仍下发 agent）—— 缺省值
# enforce = 按判定本地直答
# 切 enforce 需要人先看『LLM 可观测 → 意图漏斗』页的拦截率与误拦复盘数据决定。
# 按 AS-BOT 覆盖：adh_as_bots.persona 里加键 "intent_gate"（值同上三档）。
INTENT_GATE_MODE=shadow
# 业务实体词典（指标/维度/对象别名/术语/触发词）缓存秒数：过期先给旧值 + 后台刷新，用户不等装载
INTENT_GATE_LEXICON_TTL_SECONDS=600
# 判定延迟预算(毫秒)：超预算即放行 agent 并记 gate_error（热路径只读快照，正常 <30ms）
INTENT_GATE_MAX_LATENCY_MS=200
