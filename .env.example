# ═══════════════════════════════════════════════════════════════════
# AI-DataHub 环境配置
# 复制此文件为 .env 并修改对应的值
# ═══════════════════════════════════════════════════════════════════

# ── MySQL 数据库 ──────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=chatbi_root_2024
MYSQL_USER=chatbi
MYSQL_PASSWORD=chatbi_pass_2024
MYSQL_PORT=3306

# ── 应用端口 ──────────────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ── LLM 配置 ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── 应用安全 ──────────────────────────────────────────────────────
ADH_SECRET_KEY=change-me-in-production

# ── Embedding 模型 ────────────────────────────────────────────────
# 本地 Embedding 模型路径（HuggingFace 模型 ID 或本地路径）
# 首次使用需要下载模型，请确保网络可访问 HF_ENDPOINT
EMBEDDING_MODEL_PATH=shibing624/text2vec-base-chinese
EMBEDDING_DIM=768
# HuggingFace 镜像站（国内网络推荐使用镜像）
HF_ENDPOINT=https://hf-mirror.com

# ── 元数据存储类型 ────────────────────────────────────────────────
# mysql  = MySQL 数据库（生产环境推荐）
# sqlite = SQLite 轻量级（测试/开发环境）
METADATA_DB_TYPE=sqlite

# ── 向量检索类型 ──────────────────────────────────────────────────
# default = 内存计算（从 METADATA_DB 加载 embedding，numpy 计算 L2 距离）
# doris   = Doris HNSW 向量索引（生产环境推荐，需要单独部署 Doris）
#
# 使用 default 模式时的流程：
#   1. 初始化: ./docker/sqlite/init.sh
#   2. 同步元数据: python -m sync.metadata_sync
#   3. 重建向量: python -m sync.rebuild_vectors
#   4. 启动应用: python -m backend.main
VECTOR_DB_TYPE=default

# ── OpenMetadata 元数据平台集成 ─────────────────────────
# 部署见 docker/om/README.md；完成初始化后将 OM_ENABLED 改为 true
OM_ENABLED=false
OM_SERVER_URL=http://localhost:8585
# ingestion-bot JWT，由 docker/om/init_om.py 自动生成并回写，无需手工配置
OM_AUTH_TOKEN=
OM_ADMIN_EMAIL=admin@open-metadata.org
OM_ADMIN_PASSWORD=admin
# 采集调度 cron（默认每日 02:00）
OM_INGESTION_CRON=0 2 * * *
# 回灌映射: OM 服务名 → 本地 datasource_id
OM_DATASOURCE_MAP=adh_doris:0,adh_mysql:0
