# ═══════════════════════════════════════════════════════════════════
# AI-DataHub 环境配置
# 复制此文件为 .env 并修改对应的值
# ═══════════════════════════════════════════════════════════════════

# ── MySQL 数据库 ──────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=chatbi_root_2024
MYSQL_USER=chatbi
MYSQL_PASSWORD=chatbi_pass_2024
MYSQL_PORT=3306

# ── 应用端口 ──────────────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ── LLM 配置 ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── 应用安全 ──────────────────────────────────────────────────────
ADH_SECRET_KEY=change-me-in-production

# ── RDF 三元组存储 (Oxigraph) ───────────────────────────────────────
# 轻量级 SPARQL 1.1 端点，用于 GraphRAG 本体检索
OXIGRAPH_URL=http://localhost:7878

# ── 元数据存储类型 ────────────────────────────────────────────────
# mysql = MySQL 数据库（默认，生产环境推荐）
# doris = Apache Doris（兼容 MySQL 协议）
METADATA_DB_TYPE=mysql
METADATA_DB_HOST=localhost
METADATA_DB_PORT=3306
METADATA_DB_USER=chatbi
METADATA_DB_PASSWORD=chatbi_pass_2024
METADATA_DB_DATABASE=adh

# ── OpenMetadata 元数据平台集成 ─────────────────────────
# 部署见 docker/om/README.md；完成初始化后将 OM_ENABLED 改为 true
OM_ENABLED=false
OM_SERVER_URL=http://localhost:8585
# ingestion-bot JWT，由 docker/om/init_om.py 自动生成并回写，无需手工配置
OM_AUTH_TOKEN=
OM_ADMIN_EMAIL=admin@open-metadata.org
OM_ADMIN_PASSWORD=admin
# 采集调度 cron（默认每日 02:00）
OM_INGESTION_CRON=0 2 * * *
# 回灌映射: OM 服务名 → 本地 datasource_id
OM_DATASOURCE_MAP=adh_doris:0,adh_mysql:0
