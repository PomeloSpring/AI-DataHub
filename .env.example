# ═══════════════════════════════════════════════════════════════════
# AI-DataHub 环境配置
# 复制此文件为 .env 并修改对应的值
# ═══════════════════════════════════════════════════════════════════

# ── MySQL 数据库 ──────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=chatbi_root_2024
MYSQL_USER=chatbi
MYSQL_PASSWORD=chatbi_pass_2024
MYSQL_PORT=3306

# ── 应用端口 ──────────────────────────────────────────────────────
# BACKEND_PORT 只是 compose 的宿主映射；后端进程监听口的唯一登记处是
# backend/scripts/services.conf（web:backend.app.main:8000），改它要同步 vite 代理与
# nginx 上游，见 tests/test_merged_webapp.py 的端口口径护栏。
BACKEND_PORT=8000
# FRONTEND_PORT 是前端启动端口的唯一配置源：start-all.sh / stop-all.sh /
# kill-ports.sh 与 frontend/vite.config.ts 都读这一个键（本地 dev 与容器同源）。
# 后端侧同样有消费方：backend/common/config.py 解析为 FRONTEND_PORT，供系统监控
# （/api/monitoring/services）探测前端与报告链接拼接 —— 在此写死一份只会造成
# “监控报假故障”，改端口后无需再动后端代码。
FRONTEND_PORT=3000

# ── LLM 配置 ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── 应用安全 ──────────────────────────────────────────────────────
# 凭据类字段的 AES-256-GCM 密钥（数据源密码 / 模型 api_key / 用户邮箱手机）。
# 必须换成真随机值：留下面的占位值等于「密钥是公开常量」，存的是密文但谁都能解开。
# 生成：python -c 'import secrets;print(secrets.token_urlsafe(48))'
# 换密钥不得直接改本行！存量密文会全部解不开，要走重加密迁移（dry-run 默认）：
#   venv/bin/python -m backend.scripts.rotate_secret_key          # 体检
#   venv/bin/python -m backend.scripts.rotate_secret_key --apply  # 迁移 + 写本文件 + 备份
ADH_SECRET_KEY=change-me-in-production
# 置 1 时，占位/空密钥直接拒绝启动（fail-closed）。默认不阻断：存量部署用占位值
# 加密过的行要先重加密，硬拦会把服务打死 —— 由人决策，不由代码默认。
# 非严格模式下密钥缺陷仍会启动 ERROR + 挂到 /health 的 security_advisories（不静默）。
# ADH_SECRET_KEY_STRICT=1

# ── 会话消息入库投影（实现：backend/core/conversation_store.py）──────
# 哪些「未经展示治理的中间产物」以多大尺度落库；0 = 该类完全不落。
# 被裁/被丢的行都带可诊断标记（result_truncated / result_omitted / thinking_truncated 等），
# 不静默少内容；用户可见正文与已治理结果集不受本组配置影响。
CONV_TOOL_RESULT_MAX_CHARS=4000      # tool_calls[].result（工具原始返回体；摘要见 result_preview）
CONV_THINKING_MAX_CHARS=4000         # 模型思考链
CONV_PROCESS_STEP_MAX_CHARS=2000     # 执行过程单步文本
CONV_PROCESS_MAX_STEPS=120           # 执行过程最多保留几步
CONV_RAW_RESPONSE_MAX_CHARS=4000     # ai_raw_response（与正文同值时直接不落，不存三份）
CONV_PROGRESS_STAGE_MAX=60           # 任务进度阶段条数（只留最近 N 条）

# ── 会话与观测流水保留策略（内置任务 conversation_history_retention，每日 04:40）──
# 观测流水超期删除；长期未活跃会话只剥明细不删正文（行上标 storage_state='trimmed'）。
# 删除整段会话是产品决策，不在该任务里擅自做。
RETENTION_LLM_SPAN_DAYS=90           # adh_llm_spans / adh_llm_traces 保留天数
RETENTION_CONVERSATION_TRIM_DAYS=180 # 会话剥明细的不活跃阈值
RETENTION_RESULT_ROWS_KEEP=200       # 裁剪后结果集保留行数（与报表渲染口径一致）

# ── 工作空间配额缺省（无登记行时的生效值；唯一裁决点 core/role_service）──────────
# 语义：adh_user_workspace_quota 无该用户行 = 用这里的缺省（不是"不限制"）；有行 = 行值权威，
#       行里 disk_quota_bytes=0 才是管理员显式"不设限"。达到磁盘上限时新建会话被 409 拒绝。
# 与 docker/mysql/workspace_disk_quota_default_migration.sql 的列缺省必须同值。
WORKSPACE_QUOTA_DEFAULT_MAX_WORKSPACES=5
WORKSPACE_DISK_QUOTA_DEFAULT_BYTES=524288000   # 每工作空间 500MB

# ── RDF 三元组存储 (Oxigraph) ───────────────────────────────────────
# 轻量级 SPARQL 1.1 端点，用于 GraphRAG 本体检索
OXIGRAPH_URL=http://localhost:7878
# 图重建写入批量大小：一次 INSERT DATA 装多少个节点。
# 背景：旧实现每列一次 SPARQL UPDATE，而 kind='business' 的保存会触发
# datasource_id=0（“聚合全部数据源”）的全目录重建，1.5 万+ 列就是 1.5 万次
# 串行 HTTP 往返，表现为 save_draft 卡死数百秒不返回。调大可加快，调小可降低
# 单次请求体积；至少为 1。
GRAPH_WRITE_CHUNK=500
# 整场图重建的墙钟预算（秒）。超出即中断并报已写进度，绝不返回部分完成的 success。
# 0 = 明确关闭上界（只给需要跑超大全量重建的场景）；值解析失败会回退默认值而不是关掉防护。
GRAPH_BUILD_DEADLINE_S=600

# ── Redis（分布式缓存 + Celery 队列）───────────────────────
# 统一缓存后端：数据源/菜单/Dashboard/元数据等跨实例共享缓存，进程重启不丢。
# Redis 不可用时缓存透明降级为“无缓存”（回源计算），不影响正确性。
REDIS_URL=redis://localhost:6379/0
# 未设 REDIS_URL 时的回退项：
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ── 元数据存储类型 ────────────────────────────────────────────────
# mysql = MySQL 数据库（默认，生产环境推荐）
# doris = Apache Doris（兼容 MySQL 协议）
METADATA_DB_TYPE=mysql
METADATA_DB_HOST=localhost
METADATA_DB_PORT=3306
METADATA_DB_USER=chatbi
METADATA_DB_PASSWORD=chatbi_pass_2024
METADATA_DB_DATABASE=adh

# ── OpenMetadata 元数据平台集成 ─────────────────────────
# 部署见 docker/om/README.md；完成初始化后将 OM_ENABLED 改为 true
OM_ENABLED=false
OM_SERVER_URL=http://localhost:8585
# ingestion-bot JWT，由 docker/om/init_om.py 自动生成并回写，无需手工配置
OM_AUTH_TOKEN=
OM_ADMIN_EMAIL=admin@open-metadata.org
OM_ADMIN_PASSWORD=admin
# 采集调度 cron（默认每日 02:00）
OM_INGESTION_CRON=0 2 * * *
# 回灌映射: OM 服务名 → 本地 datasource_id
OM_DATASOURCE_MAP=adh_doris:0,adh_mysql:0

# ── LLM 交互可观测（看板『LLM 交互可观测』的数据源）──
# 未开启时全链路 no-op（不落 adh_llm_traces/adh_llm_spans）；开启后 span 文本按上限截断（敏感护栏）
OBSERVABILITY_ENABLED=true
# OBSERVABILITY_SPAN_MAX_CHARS=4096
# credit → 成本折算单价与币种：Qoder CLI 不回报账单成本（实测 total_cost_usd / costUSD 恒为 0），
# 「成本」列由 credit × 单价折算得到（属估算，不是账单值）。
# 默认 0.04 CNY = Qoder CN 企业资源包官方起购价 80 元 / 2,000 Credits
# （源：docs.qoder.cn/product-overview/billing-description；国际版对照 $0.02/Credit）
# RATE 填 0 = 不折算，成本列显示 —（不臆造价格）
OBSERVABILITY_CREDIT_COST_RATE=0.04
OBSERVABILITY_CREDIT_COST_CURRENCY=CNY

# ── 前置意图漏斗（Intent Gate）—— chat 输入进 qodercli 执行层之前的确定性分流 ──
# 寒暄/无效输入/能力询问/使用说明/涉密索要本地直答（不起子进程、不烧 credit），
# 判定不准一律放行 agent。分流只用规则+词典/本体别名命中，不调任何模型。
# off     = 不判定（完全沿用旧行为）
# shadow  = 只判定与度量，行为不变（所有输入仍下发 agent）—— 缺省值
# enforce = 按判定本地直答
# 切 enforce 需要人先看『LLM 可观测 → 意图漏斗』页的拦截率与误拦复盘数据决定。
# 按 AS-BOT 覆盖：adh_as_bots.persona 里加键 "intent_gate"（值同上三档）。
INTENT_GATE_MODE=shadow
# 业务实体词典（指标/维度/对象别名/术语/触发词）缓存秒数：过期先给旧值 + 后台刷新，用户不等装载
INTENT_GATE_LEXICON_TTL_SECONDS=600
# 判定延迟预算(毫秒)：超预算即放行 agent 并记 gate_error（热路径只读快照，正常 <30ms）
INTENT_GATE_MAX_LATENCY_MS=200

# ── 并发闸门与提供商繁忙重试（chat 交互回合）──
# 全平台**同时在跑的交互回合数**（每进程口径，不是每用户）。web 为单进程，因此等价
# 于全局；改多副本部署前必须先换成 Redis 租约式闸门，否则上限会被乘上进程数
# （celery-worker 是另一个进程，它跑的定时分析不受此闸门约束）。
# 超出上限的回合不静默丢弃，而是排队，并把「第几位 / 预计多久」回给前端。
MAX_CONCURRENT_AGENT_TURNS=6
# 提供商返回繁忙/限流（rate_limit / overloaded / 429 / 529 / 503）时的自动重试次数上限
# （0 = 关掉自动重试，只给用户“稍后再试”提示）。只对“未流出任何正文”的回合重试。
AGENT_BUSY_MAX_RETRIES=2
# 单次退避等待上限（秒）：提供商给的 Retry-After 超过它就不再让用户干等，
# 直接给可操作提示（重试本轮 / 切换模型）。
AGENT_BUSY_MAX_RETRY_WAIT_S=20
# 手动压缩上下文（/compact）的墙钟上限（秒）：超时会中止并显式报错，不假装成功
CONTEXT_COMPACT_TIMEOUT_SECONDS=120

# ── Elasticsearch 内置能力（平台内置服务，非数据源）──
# 打开后 AS-BOT 可在「工具权限」里勾选 Elasticsearch 组（列索引/看字段/跑 SQL）。
# 凭据只在本文件，不入数据库、不在「MCP 服务」页明文显示；未开启时该组不出现在目录。
ES_MCP_ENABLED=false
# ES_URL=http://localhost:9200
# 认证二选一：API Key 优先于用户名口令
# ES_API_KEY=...
# ES_USERNAME=elastic
# ES_PASSWORD=...
# 自签证书集群才置 false（缺省校验证书）
# ES_VERIFY_CERTS=true
# ES_TIMEOUT_SEC=20
# ES_MAX_ROWS=1000
# 可查索引模式白名单（逗号分隔）：每项就是一个可查范围（同 Kibana data view），
# 索引按时间分片时只写模式（logs-*），查询直接 FROM "logs-*"，平台不向集群展开成月索引。
# **留空 = 不开放任何范围**（fail-closed，与"空角色授权不等于全量"同口径）。
# 注意：范围内的数据应已脱敏 —— 本能力不参与列级/行级数据权限治理。
# ES_ALLOWED_INDEXES=orders-*,cases,clients

# ══════════════════════════════════════════════════════════════════════════
# 知识库外部检索通道（阿里云百炼 / DashScope）
# ══════════════════════════════════════════════════════════════════════════
# 凭据纪律（护栏 §7）：密钥**只从环境读**，不得写进 adh_knowledge_bases.source_config
# （API 已改为写入即拒、读取即掩）。知识库行里只存非密项：业务空间 ID / 知识库 ID(index_id)。
# 与 QMIND_TOKEN 同一条律：留空 = 百炼类知识库不可检索（检索时逐源回报失败原因，
# 不静默回退成"库里没有"）。
# DASHSCOPE_API_KEY=sk-...
# 服务地址（缺省公网 DashScope；专有云/VPC 按需覆盖）
# BAILIAN_ENDPOINT=https://dashscope.aliyuncs.com
# 检索接口响应可能较慢（官方文档明示），超时秒数；接口幂等，失败只补一次
# BAILIAN_TIMEOUT=10
