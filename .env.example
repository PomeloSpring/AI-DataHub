# ═══════════════════════════════════════════════════════════════════
# AI-DataHub 环境配置
# 复制此文件为 .env 并修改对应的值
# ═══════════════════════════════════════════════════════════════════

# ── MySQL 数据库 ──────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=chatbi_root_2024
MYSQL_USER=chatbi
MYSQL_PASSWORD=chatbi_pass_2024
MYSQL_PORT=3306

# ── 应用端口 ──────────────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ── LLM 配置 ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── 应用安全 ──────────────────────────────────────────────────────
ADH_SECRET_KEY=change-me-in-production

# ── Embedding 模型 ────────────────────────────────────────────────
EMBEDDING_MODEL_PATH=shibing624/text2vec-base-chinese
EMBEDDING_DIM=768
HF_ENDPOINT=https://hf-mirror.com

# ── 元数据存储类型 ────────────────────────────────────────────────
# mysql  = MySQL 数据库（生产环境推荐）
# sqlite = SQLite 轻量级（测试/开发环境）
METADATA_DB_TYPE=sqlite

# ── 向量检索类型 ──────────────────────────────────────────────────
# default = 内存计算（从 METADATA_DB 加载 embedding，numpy 计算 L2 距离）
# doris   = Doris HNSW 向量索引（生产环境推荐，需要单独部署 Doris）
#
# 使用 default 模式时的流程：
#   1. 初始化: ./docker/sqlite/init.sh
#   2. 同步元数据: python -m sync.metadata_sync
#   3. 重建向量: python -m sync.rebuild_vectors
#   4. 启动应用: python -m backend.main
VECTOR_DB_TYPE=default

# ── Redis 缓存（可选） ──────────────────────────────────────────────
# 用于分布式元数据缓存，多实例部署时共享缓存
# CACHE_BACKEND=local  本地内存缓存（默认，单实例够用）
# CACHE_BACKEND=redis  Redis 分布式缓存（多实例部署推荐）
CACHE_BACKEND=local
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_PASSWORD=

# Redis 连接 URL（同时用于 Celery broker 和缓存，格式: redis://[:password]@host:port/db）
# 设置此值后可省略 REDIS_HOST/PORT/DB/PASSWORD
# REDIS_URL=redis://localhost:6379/0

# ── DataFusion Gateway（SQL 执行引擎，支持行级/列级安全）─────────
# 独立 Rust 服务，提供 AST 级别的 RLS 注入和查询优化
# GATEWAY_URL=http://localhost:50051
# GATEWAY_TIMEOUT=30
# GATEWAY_ENABLED=true
